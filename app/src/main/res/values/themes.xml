<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme -->
    <style name="Theme.FruitFusion" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#7c5cfc</item>
        <item name="colorPrimaryVariant">#5a3fd6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#ff9f43</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#eef1f7</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Splash theme – shown while the activity starts -->
    <style name="Theme.FruitFusion.Splash" parent="Theme.FruitFusion">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
